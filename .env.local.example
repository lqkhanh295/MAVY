# MAVY Master Chef AI - API Keys Configuration
# Hỗ trợ tối đa 10 API Key với cơ chế tự động xoay vòng khi gặp lỗi Rate Limit (429) hoặc Quota Exceeded (403)

# Cách 1: Danh sách cách nhau bằng dấu phẩy
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2

# Cách 2: Khai báo từng key riêng lẻ (1 đến 10)
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here
GEMINI_API_KEY_4=your_gemini_api_key_4_here
GEMINI_API_KEY_5=your_gemini_api_key_5_here

# (Tùy chọn) OpenAI API Keys nếu sử dụng mô hình OpenAI
# OPENAI_API_KEYS=sk-xxx,sk-yyy
